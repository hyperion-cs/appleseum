{
  "name": "appleseum-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.unit.ts",
    "format": "prettier --config .prettierrc.json --write src tests *.ts *.json ../scripts/*.js ../scripts/*.json",
    "format:check": "prettier --config .prettierrc.json --check src tests *.ts *.json ../scripts/*.js ../scripts/*.json",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
